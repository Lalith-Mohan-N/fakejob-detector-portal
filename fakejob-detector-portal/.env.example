# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fakejobdb
DEV_DATABASE_URL=sqlite:///./dev.db

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Kaggle API (for downloading EMSCAD dataset)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model paths
MODEL_DIR=backend/app/ml_models/artifacts
